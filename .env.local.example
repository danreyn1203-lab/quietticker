# Copy this file to .env.local and set your own values.
# .env.local is git-ignored, so your real secrets never get committed.

# Public site URL (used for SEO: canonical links, sitemap, Open Graph).
# Leave unset in dev (defaults to http://localhost:3000); set to your real
# domain in production, e.g. https://throughline.example.
NEXT_PUBLIC_SITE_URL=

# The password you type at /admin to edit research. Pick a strong one.
AUTHOR_PASSWORD=

# A long random string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTHOR_SESSION_SECRET=

# ---- Newsletter email (SMTP, via Nodemailer) ----
# Fill these to send real subscriber emails. Leave blank for mailto-fallback mode.
# Gmail example: host smtp.gmail.com, port 587, user = your address,
# pass = a Google "App Password". Restart the dev server after editing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NEWSLETTER_FROM=
